{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusicTag Lite",
  "version": "0.1.0",
  "identifier": "app.musictaglite.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MusicTag Lite",
        "label": "main",
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 580,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0c0e13"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Minimal music tag editor",
    "longDescription": "Edit title, artist, album, lyrics, cover art and extended metadata of your music files without re-encoding audio.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
